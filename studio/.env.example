# Copy to .env.local. Leave unset to use the local DB from `npm run db`.
MONGODB_URI=mongodb://127.0.0.1:27017/crime-studio

# Optional: AI keys. You can also paste them on the AI connections page (/settings/ai).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ELEVENLABS_API_KEY=
